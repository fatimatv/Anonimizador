# Runtime
NODE_ENV=development
WEB_ORIGIN=http://localhost:3000
API_PORT=3001

# Auth placeholders. Replace before using outside local development.
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=anonimizador_session
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=900
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD_HASH=replace-with-argon2id-hash
PUBLIC_ACCESS_ENABLED=false

# Database
DATABASE_URL=postgresql://anonimizador:anonimizador_dev_password@localhost:5432/anonimizador?schema=public
POSTGRES_USER=anonimizador
POSTGRES_PASSWORD=anonimizador_dev_password
POSTGRES_DB=anonimizador

# Redis / queue
REDIS_URL=redis://localhost:6379
PROCESSING_QUEUE_DRIVER=memory

# Temporary storage
TEMP_STORAGE_ROOT=./tmp-storage
TEMP_FILE_TTL_MINUTES=60
RETENTION_CLEANUP_INTERVAL_MS=900000
MAX_BATCH_FILES=20
MAX_FILE_SIZE_MB=20

# Security
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
AUDIT_HASH_SECRET=replace-with-a-separate-audit-hash-secret
DETECTION_HASH_SECRET=replace-with-a-separate-detection-hash-secret
ANONYMIZATION_MASKING_POLICY=balanced

# Optional local OCR for scanned PDFs. Requires a local command such as Tesseract.
OCR_ENABLED=false
OCR_COMMAND=tesseract
OCR_LANGUAGES=spa+eng
OCR_MIN_CONFIDENCE=45
# Optional advanced override, for example:
# OCR_ARGS_JSON=["{image}","stdout","-l","spa+eng","tsv"]
